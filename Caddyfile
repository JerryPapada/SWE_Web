{
	local_certs
}

:80 {
	redir https://{host}{uri} permanent
}

localhost {
	tls internal

	# Backend: API, admin, auth, static, media
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /admin/* {
		reverse_proxy backend:8000
	}
	handle /accounts/* {
		reverse_proxy backend:8000
	}
	handle /static/* {
		reverse_proxy backend:8000
	}
	handle /media/* {
		reverse_proxy backend:8000
	}

	# Frontend: everything else
	handle {
		reverse_proxy frontend:5173
	}
}
