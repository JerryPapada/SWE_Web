# Cinema Ticket System - Environment Variables
# Copy this file to .env and update values

# Django Settings
DEBUG=1
SECRET_KEY=your-super-secret-key-change-this
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://cinema_user:cinema_password@db:5432/cinema_db
POSTGRES_DB=cinema_db
POSTGRES_USER=cinema_user
POSTGRES_PASSWORD=cinema_password

# Email Configuration (for reservation notifications)
# For development, use console backend to print emails to terminal:
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For production, use SMTP (Gmail example below):
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@cinema.local

# Google OAuth2 (for social authentication)
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4200/auth/google/callback

# Frontend URL (for CORS and OAuth callbacks)
FRONTEND_URL=http://localhost:4200

# Django Settings Module
DJANGO_SETTINGS_MODULE=config.settings.development
